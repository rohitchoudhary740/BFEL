# ==============================================================================
# BFEL FLOW — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file with production credentials to source control.

# ------------------------------------------------------------------------------
# Django Backend Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# Database Configuration (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bfel_flow_db
DB_USER=bfel_admin
DB_PASSWORD=replace_with_strong_database_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js 15)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# ------------------------------------------------------------------------------
# External Services (Placeholders for Future Production Layers)
# ------------------------------------------------------------------------------
# SMS Gateway / OTP Provider (e.g. Gupshup, Twilio, Fast2SMS)
SMS_GATEWAY_PROVIDER=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=BFELMP

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Storage (AWS S3 / MinIO / Cloud Storage for Claims & Receipts)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
